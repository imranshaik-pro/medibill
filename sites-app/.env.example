# AI product-label OCR: configure one provider.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
PRODUCT_VISION_MODEL=gpt-4o-mini

# Optional online business/GST/drug-license lookup providers.
GST_LOOKUP_API_URL=
GST_LOOKUP_API_KEY=
GST_LOOKUP_API_TOKEN=
DL_LOOKUP_API_URL=
DL_LOOKUP_API_KEY=
DL_LOOKUP_API_TOKEN=
BUSINESS_LOOKUP_API_URL=
BUSINESS_LOOKUP_API_KEY=
BUSINESS_LOOKUP_API_TOKEN=

# Required only after replacing Sites-managed authentication.
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare resource bindings are configured in wrangler.toml, not as secrets.
# DB -> D1 database binding
# BUCKET -> R2 bucket binding
