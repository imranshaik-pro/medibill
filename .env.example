# Database Configuration
DATABASE_URL=postgresql://medibill_user:medibill_password@postgres:5432/medibill_db
POSTGRES_DB=medibill_db
POSTGRES_USER=medibill_user
POSTGRES_PASSWORD=medibill_password

# Application Configuration
APP_ENV=development
DEBUG=true
APP_PORT=8000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3001"]

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Email (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Logging
LOG_LEVEL=INFO
